# The playground: phlite compiled to WebAssembly (with threads) and a Svelte app that runs it in a Web Worker.
#
#   just wasm      build the WebAssembly packages (release, optimised): pkg/ with threads and pkg-single/ without,
#                  for pages that can't share memory
#   just dev       the app with hot reloading at http://localhost:5173 (after `just wasm`)
#   just build     build everything into app/dist
#
# Needs: rustup (the nightly in rust-toolchain.toml is installed on first use), wasm-bindgen-cli at the version in
# Cargo.toml, and Node with npm.

wasm_bindgen_version := "0.2.130"

default:
    @just --list

# The pinned nightly, with rust-src and the wasm32 target
toolchain:
    rustup toolchain install

wasm: toolchain
    #!/usr/bin/env bash
    set -euo pipefail
    if [ "$(wasm-bindgen --version 2>/dev/null)" != "wasm-bindgen {{wasm_bindgen_version}}" ]; then
        echo "Need wasm-bindgen {{wasm_bindgen_version}}: cargo install wasm-bindgen-cli --version {{wasm_bindgen_version}} --locked" >&2
        exit 1
    fi
    # With threads: the shared-memory flags in .cargo/config.toml
    cargo build --release
    just _package target/wasm32-unknown-unknown/release/phlite_web.wasm pkg phlite-web
    # Without: RUSTFLAGS replaces the config's flags (and its own target directory keeps both builds cached)
    RUSTFLAGS="" cargo build --release --no-default-features --target-dir target/single
    just _package target/single/wasm32-unknown-unknown/release/phlite_web.wasm pkg-single phlite-web-single
    just _npm-install
    for dir in pkg pkg-single; do
        app/node_modules/.bin/wasm-opt -O3 --enable-threads --enable-bulk-memory --enable-mutable-globals \
            --enable-nontrapping-float-to-int --enable-sign-ext --enable-reference-types --enable-multivalue \
            --strip-debug $dir/phlite_web_bg.wasm -o $dir/phlite_web_bg.wasm
    done
    ls -la pkg/phlite_web_bg.wasm pkg-single/phlite_web_bg.wasm

# Bindings for a built module, as an npm package (the thread pool's workers import the package by its directory)
_package wasm dir name:
    rm -rf {{dir}}
    wasm-bindgen --target web --out-dir {{dir}} {{wasm}}
    printf '{\n  "name": "{{name}}",\n  "version": "0.1.0",\n  "type": "module",\n  "main": "phlite_web.js",\n  "types": "phlite_web.d.ts"\n}\n' > {{dir}}/package.json

_npm-install:
    cd app && ([ -d node_modules ] || npm ci)

dev: _npm-install
    cd app && npm run dev

build: wasm
    cd app && npm run build

# Type-check the app
check: _npm-install
    cd app && npm run check

# Rust unit tests (on the host, not in WebAssembly)
test:
    cargo +nightly-2026-11-01 test --target x86_64-unknown-linux-gnu -Z build-std=std,panic_abort
