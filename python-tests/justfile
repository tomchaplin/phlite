# Fuzz tests and benchmarks for phlite's Python packages against reference implementations.
# Requires `just` and `uv`. There are two uv environments, since the references need different Pythons:
#   .        Python 3.11: phlite.clouds, phlite.networks and phlite.images, against ripser, giotto-ph, grpphati, gudhi,
#            pyflagser and cripser
#   latest/  Python 3.13: phlite.complexes, against PHAT and LoPHAT (and phlite_complexes' own tests)
# Both get every phlite package (phlite-core first, since the others depend on it).

set shell := ["bash", "-euo", "pipefail", "-c"]
# Pass recipe arguments on as "$@", keeping their quoting
set positional-arguments

# The test files for each environment; tests/conftest.py and tests/mod2.py are shared.
# Each package's tests are `tests/test_<package>_<pipeline>.py` (e.g. test_clouds_rips.py), all picked up here, so a
# new pipeline's tests need no change to this file. test_core.py checks phlite.core: `Algorithm`, the namespace
# package, and the registry of pipelines' defaults (against the docstrings and the book). phlite_complexes' test
# against grpphati's own columns needs grpphati, so runs in the main environment (and skips in latest).
# (test_extended_persistence.py tests phlite.complexes against GUDHI, which only the main environment has)
main_tests := `shopt -s nullglob; echo tests/test_core.py tests/test_{clouds,networks,images}*.py tests/test_extended_persistence.py` + " ../phlite_complexes/tests/test_cells.py::test_real_grpphati"
latest_tests := `shopt -s nullglob; echo tests/test_complexes*.py` + " ../phlite_complexes/tests"
latest := "uv run --no-sync --project latest"

# PHAT's only PyPI release is an sdist whose metadata doesn't match its version, which uv and pip refuse to install,
# so we unpack it and build it from the directory. It needs pybind11 < 3 to build.
phat_url := "https://files.pythonhosted.org/packages/43/82/c14de81dc2953a71a060f72f2bc34c41996307956b162751f2a47e2c78f7/phat-1.5.0a.tar.gz"
phat_sha256 := "51e7fe5e05adf5c7e0895765572fff05b979731234251f13011610d71d4980ab"

# List available recipes
default:
    @just --list

# Create both environments with the reference implementations
venv:
    uv sync --inexact
    uv sync --inexact --project latest --python 3.13
    {{latest}} python -c "import phat" 2>/dev/null || just install-phat

# Build PHAT's Python bindings into the latest environment
install-phat:
    #!/usr/bin/env bash
    set -euo pipefail
    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' EXIT
    curl -sSfL -o "$dir/phat.tar.gz" "{{phat_url}}"
    echo "{{phat_sha256}}  $dir/phat.tar.gz" | sha256sum -c --quiet
    tar -xzf "$dir/phat.tar.gz" -C "$dir"
    cd latest
    uv pip install "pybind11<3" setuptools
    uv pip install --no-build-isolation "$dir"/phat-*/

# Every phlite package's crate, phlite_bindings (phlite-core) first: the others depend on it, and maturin would look for
# it on PyPI if it weren't installed already
packages := "phlite_bindings phlite_complexes phlite_clouds phlite_networks phlite_images"

# Build every phlite package (release mode) into both environments
build: venv
    for crate in {{packages}}; do uv run --no-sync maturin develop --uv --release -m ../$crate/Cargo.toml; done
    for crate in {{packages}}; do {{latest}} maturin develop --uv --release -m ../$crate/Cargo.toml; done

# Run every Python test, fuzzing briefly (100 examples per test)
test *pytest_args: build
    just _pytest "$@"

# Fuzz for longer, e.g. `just fuzz 20000` (examples per test)
fuzz examples="5000" *pytest_args: build
    HYPOTHESIS_PROFILE=fuzz FUZZ_EXAMPLES="$1" just _pytest "${@:2}"

# With `PHLITE_JUNIT_DIR` set, each environment also writes JUnit XML there (for CI's test report)
_pytest *pytest_args:
    uv run --no-sync pytest {{main_tests}} ${PHLITE_JUNIT_DIR:+--junitxml="$PHLITE_JUNIT_DIR/main.xml"} "$@"
    {{latest}} pytest {{latest_tests}} ${PHLITE_JUNIT_DIR:+--junitxml="$PHLITE_JUNIT_DIR/latest.xml"} "$@"

# The pytest-benchmark suites for each environment, and where the quick baselines are saved. As for the tests, each
# submodule's suites are `benchmarks/bench_<submodule>_<pipeline>.py` (e.g. bench_clouds_rips.py), all picked up here;
# each describes itself for the reports in a `SUITE` dict (see benchmarks/suites.py).
# (bench_extended_persistence.py benchmarks phlite.complexes against GUDHI, which only the main environment has)
main_benches := `shopt -s nullglob; echo benchmarks/bench_{clouds,networks,images}*.py benchmarks/bench_extended_persistence.py`
latest_benches := `shopt -s nullglob; echo benchmarks/bench_complexes*.py`
storage := "--benchmark-storage=file://benchmarks/baselines"

# Run the Python benchmarks in both environments, with pytest options, e.g. `just bench -m quick` or `just bench -k grid`
bench *args: build
    just _bench allow-empty "$@"

# Compare the quick benchmarks with the saved baseline, failing if any is more than 50% slower
bench-check *args: build
    PHLITE_BENCH_ROUNDS=5 just _bench require-all -m quick {{storage}} --benchmark-compare --benchmark-compare-fail=min:50% "$@"

# Save the quick benchmarks as the new baseline (after an intended change in performance, or on a new machine)
bench-baseline: build
    rm -rf benchmarks/baselines
    PHLITE_BENCH_ROUNDS=5 just _bench require-all -m quick {{storage}} --benchmark-save=quick

# Each suite runs on its own, into benchmarks/results/suites/<suite>.json (pytest-benchmark writes its JSON only when a
# run finishes), so a suite that fails or is stopped loses only its own results; with RESUME=1, suites that already have
# results are skipped, to carry on after one. (`just bench-docs` at the root also runs the Rust benchmarks first.)
#
# Run every Python benchmark into benchmarks/results/suites/ and regenerate BENCHMARKS.md
bench-docs: build
    #!/usr/bin/env bash
    set -uo pipefail
    mkdir -p benchmarks/results/suites
    failed=()
    run() {  # run <python command...> -- <suite files>
        local runner=() ; while [ "$1" != -- ]; do runner+=("$1"); shift; done; shift
        for suite in "$@"; do
            local name out
            name=$(basename "$suite" .py); out="benchmarks/results/suites/$name.json"
            if [ -n "${RESUME:-}" ] && [ -f "$out" ]; then echo "== $name: already done"; continue; fi
            echo "== $name ($(date +%H:%M))"
            "${runner[@]}" pytest "$suite" -q -p no:warnings --benchmark-json="$out" || failed+=("$name")
        done
    }
    run uv run --no-sync -- {{main_benches}}
    run {{latest}} -- {{latest_benches}}
    [ ${#failed[@]} -eq 0 ] || echo "Failed (rerun with RESUME=1 to run only these): ${failed[*]}"
    uv run --no-sync python benchmarks/report.py benchmarks/results/suites/*.json --out BENCHMARKS.md

# A light benchmark for CI: phlite's default serial and parallel algorithms on the quick cases, with the reference
# implementations each suite names in `SUITE["light_references"]` (ripser, grpphati, PHAT, ...) for scale, a few
# rounds each. benchmarks/results/light/report.md
# gives phlite's times as multiples of the references' in the same run, and compares those with the run in
# `$LIGHT_BASELINE` (a directory of the same JSON files, e.g. from main) if set. Nothing fails.
bench-light: build
    rm -rf benchmarks/results/light && mkdir -p benchmarks/results/light
    PHLITE_BENCH_LIGHT=1 PHLITE_BENCH_ROUNDS=3 \
        uv run --no-sync pytest {{main_benches}} -m quick -q -p no:warnings --benchmark-json=benchmarks/results/light/main.json
    PHLITE_BENCH_LIGHT=1 PHLITE_BENCH_ROUNDS=3 \
        {{latest}} pytest {{latest_benches}} -m quick -q -p no:warnings --benchmark-json=benchmarks/results/light/latest.json
    uv run --no-sync python benchmarks/light_report.py benchmarks/results/light \
        ${LIGHT_BASELINE:+--baseline "$LIGHT_BASELINE"} --out benchmarks/results/light/report.md

# Run pytest on each environment's benchmarks. With `allow-empty`, a filter may leave no benchmarks in one of them
# (pytest's exit code 5); with `require-all` that's an error.
_bench mode *args:
    #!/usr/bin/env bash
    set -uo pipefail
    mode=$1; shift
    status=0
    check() { s=$1; if [ "$s" != 0 ] && { [ "$s" != 5 ] || [ "$mode" != allow-empty ]; }; then status=$s; fi; }
    uv run --no-sync pytest {{main_benches}} "$@"; check $?
    uv run --no-sync --project latest pytest {{latest_benches}} "$@"; check $?
    exit "$status"

# Remove both environments and hypothesis' example database
clean:
    rm -rf .venv latest/.venv .hypothesis
