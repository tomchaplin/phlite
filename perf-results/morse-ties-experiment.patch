+/// How [`Chain::filter_with`] orders cells with the same value (which changes which cells are paired, but not the
+/// values of the bars).
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
+pub enum Ties {
+    /// By index, as given. Every face must then enter before its cofaces in that order.
+    #[default]
+    Index,
+    /// So that as many of them as possible pair with each other as apparent pairs, which the reduction skips: within
+    /// each run of cells with the same value, the reverse of a greedy collapse of the run (a discrete gradient, as in
+    /// the filtered Morse reduction of Mischaikow and Nanda, which Perseus 6 uses on cubical grids). Cells with the
+    /// same value as a face no longer need a larger index than it.
+    Morse,
+}
+
+impl<CF: IntField> Chain<CF> {
+    /// Reorder each run of cells of `order` (sorted by value) that share a value, as [`Ties::Morse`] says.
+    ///
+    /// Within a run, repeatedly remove either a pair `(σ, τ)`, where `τ` is the only coface of `σ` left in the run
+    /// and `τ` has none left itself (an elementary collapse), or, when there is none, a cell with no coface left in
+    /// the run (preferring the highest dimension), which stays critical. In the reverse of that sequence each pair is
+    /// adjacent, `σ`'s other cofaces in the run come after `τ` and `τ`'s other faces before `σ`: so `σ`'s earliest
+    /// coface is `τ` and `τ`'s latest face is `σ`, an apparent pair. Faces still come before cofaces, since a cell is
+    /// only removed once none of its cofaces in the run are left.
+    fn morse_ties(&self, order: &mut [Cell], values: &[NotNan<f64>]) {
+        let n = self.n_cells();
+        // Runs of equal values, by position in `order`
+        let mut run_of = vec![u32::MAX; n];
+        let mut runs: Vec<std::ops::Range<usize>> = vec![];
+        let mut start = 0;
+        while start < n {
+            let mut end = start + 1;
+            while end < n && values[order[end].idx()] == values[order[start].idx()] {
+                end += 1;
+            }
+            if end - start > 1 {
+                for &cell in &order[start..end] {
+                    run_of[cell.idx()] = runs.len() as u32;
+                }
+                runs.push(start..end);
+            }
+            start = end;
+        }
+        if runs.is_empty() {
+            return;
+        }
+        // The cofaces of every cell (the transpose of the boundary, by index)
+        let cofaces = transpose(&self.boundary, n);
+        let faces = &self.boundary;
+        let mut left = vec![0u32; n];
+        let mut removed = vec![false; n];
+        let mut sequence: Vec<Cell> = vec![];
+        let mut free: Vec<Cell> = vec![];
+        let mut maximal: Vec<Vec<Cell>> = vec![];
+        for (r, range) in runs.iter().enumerate() {
+            let r = r as u32;
+            let in_run = |c: Cell| run_of[c.idx()] == r;
+            free.clear();
+            for m in &mut maximal {
+                m.clear();
+            }
+            let push = |c: Cell, count: u32, free: &mut Vec<Cell>, maximal: &mut Vec<Vec<Cell>>| {
+                if count == 1 {
+                    free.push(c);
+                } else if count == 0 {
+                    let dim = self.dimensions[c.idx()] as usize;
+                    if maximal.len() <= dim {
+                        maximal.resize_with(dim + 1, Vec::new);
+                    }
+                    maximal[dim].push(c);
+                }
+            };
+            for &c in &order[range.clone()] {
+                let count = cofaces.range(c).filter(|&i| in_run(cofaces.rows[i])).count() as u32;
+                left[c.idx()] = count;
+                push(c, count, &mut free, &mut maximal);
+            }
+            sequence.clear();
+            let mut remaining = range.len();
+            // Remove a cell: its faces in the run each lose a coface
+            let remove = |c: Cell,
+                              left: &mut [u32],
+                              removed: &mut [bool],
+                              sequence: &mut Vec<Cell>,
+                              free: &mut Vec<Cell>,
+                              maximal: &mut Vec<Vec<Cell>>| {
+                removed[c.idx()] = true;
+                sequence.push(c);
+                for i in faces.range(c) {
+                    let f = faces.rows[i];
+                    if in_run(f) && !removed[f.idx()] {
+                        left[f.idx()] -= 1;
+                        push(f, left[f.idx()], free, maximal);
+                    }
+                }
+            };
+            while remaining > 0 {
+                // An elementary collapse, if there is one
+                let mut paired = false;
+                while let Some(s) = free.pop() {
+                    if removed[s.idx()] || left[s.idx()] != 1 {
+                        continue;
+                    }
+                    let t = cofaces
+                        .range(s)
+                        .map(|i| cofaces.rows[i])
+                        .find(|&t| in_run(t) && !removed[t.idx()])
+                        .expect("a coface is left");
+                    if left[t.idx()] != 0 {
+                        continue;
+                    }
+                    // Removed τ then σ, so that the reverse has σ just before τ
+                    remove(t, &mut left, &mut removed, &mut sequence, &mut free, &mut maximal);
+                    remove(s, &mut left, &mut removed, &mut sequence, &mut free, &mut maximal);
+                    remaining -= 2;
+                    paired = true;
+                    break;
+                }
+                if paired {
+                    continue;
+                }
+                // Otherwise a cell with no coface left, of the highest dimension: critical
+                let c = loop {
+                    let top = maximal.iter_mut().rev().find(|m| !m.is_empty()).expect("a maximal cell is left");
+                    let c = top.pop().expect("not empty");
+                    if !removed[c.idx()] && left[c.idx()] == 0 {
+                        break c;
+                    }
+                };
+                remove(c, &mut left, &mut removed, &mut sequence, &mut free, &mut maximal);
+                remaining -= 1;
+            }
+            for (slot, &c) in order[range.clone()].iter_mut().zip(sequence.iter().rev()) {
+                *slot = c;
+            }
+        }
+    }
+}
